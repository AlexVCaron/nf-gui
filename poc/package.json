{
  "name": "nf-gui-poc",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test",
    "tauri": "tauri",
    "audit:artifacts": "node scripts/verify-artifacts.mjs",
    "audit:npm": "npm audit --audit-level=moderate",
    "audit:cargo": "cd src-tauri && cargo audit --deny warnings",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "audit:tree": "npm ls --all && cd src-tauri && cargo tree --locked -e normal,build,dev"
  },
  "dependencies": {
    "@xyflow/react": "12.11.6",
    "monaco-editor": "0.57.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.5",
    "@types/node": "26.6.6",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  },
  "overrides": {
    "dompurify": "3.4.18"
  }
}
